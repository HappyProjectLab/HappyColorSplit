<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:HappyColorSplit.Controls"
        xmlns:views="using:HappyColorSplit.Views"
        x:Class="HappyColorSplit.Views.MainWindow"
        Title="HappyColorSplit" Width="1380" Height="870" MinWidth="1120" MinHeight="740"
        Background="#111824" Icon="/Assets/HappyColorSplit.ico">
  <Window.Styles>
    <Style Selector="Border.panel"><Setter Property="Background" Value="#E61C2432" /></Style>
    <Style Selector=":is(Button).toolbar">
      <Setter Property="Height" Value="34" /><Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,6" /><Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="8" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="#182433" /><Setter Property="BorderBrush" Value="#3C5065" /><Setter Property="Foreground" Value="#D8E5EF" />
    </Style>
    <Style Selector=":is(Button).toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#263C50" /><Setter Property="BorderBrush" Value="#6A91AD" />
    </Style>
    <Style Selector=":is(ToggleButton).toolbar:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#355B76" /><Setter Property="BorderBrush" Value="#7DD3FC" /><Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector=":is(Button).toolbar.open /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#355B76" /><Setter Property="BorderBrush" Value="#7DD3FC" />
    </Style>
    <Style Selector=":is(ToggleButton).toolbar:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#416D89" />
    </Style>
    <Style Selector=":is(Button).toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#476D87" />
    </Style>
    <Style Selector=":is(Button).toolbar:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
    <Style Selector="TextBlock.switch-option"><Setter Property="Opacity" Value="0.58" /></Style>
    <Style Selector="TextBlock.switch-option.current"><Setter Property="Opacity" Value="1" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  </Window.Styles>
  <Grid>
    <controls:WindowBackdrop Opacity="0.12" />
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="28" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="6">
        <TextBlock Text="HappyColorSplit" FontSize="27" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Text[Subtitle]}" Classes="muted" FontSize="14" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ToggleButton x:Name="WorkspaceSelector" Classes="toolbar" IsChecked="{Binding IsLaserMode, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" ToolTip.Tip="{Binding Text[SwitchWorkspace]}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <TextBlock Text="{Binding Text[ColorWorkspace]}" Classes="switch-option" Classes.current="{Binding !IsLaserMode}" />
            <TextBlock Text="⇄" Opacity="0.65" />
            <TextBlock Text="{Binding Text[LaserWorkspace]}" Classes="switch-option" Classes.current="{Binding IsLaserMode}" />
          </StackPanel>
        </ToggleButton>
        <Button x:Name="WindowsIntegrationButton" Classes="toolbar" IsVisible="{Binding CanIntegrateWithWindows}">
          <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="{Binding Text[WindowsIntegration]}" /><TextBlock Text="▾" Opacity="0.65" /></StackPanel>
          <Button.Flyout>
            <Flyout>
              <StackPanel Spacing="12" MaxWidth="380">
                <TextBlock Text="{Binding Text[WindowsHelp]}" TextWrapping="Wrap" />
                <Button Content="{Binding Text[WindowsEnable]}" Command="{Binding EnableWindowsIntegrationCommand}" />
                <Button Content="{Binding Text[WindowsRemove]}" Command="{Binding RemoveWindowsIntegrationCommand}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button x:Name="LicensesButton" Classes="toolbar" Classes.open="{Binding IsLicenseWindowOpen}" Command="{Binding LicensesCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="{Binding Text[Licenses]}" /><TextBlock Text="↗" Opacity="0.65" /></StackPanel>
        </Button>
        <ToggleButton x:Name="LanguageToggle" Classes="toolbar" IsChecked="{Binding EnglishSelected, Mode=TwoWay}" ToolTip.Tip="{Binding Text[SwitchLanguage]}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <TextBlock Text="{Binding Text[GermanLanguage]}" Classes="switch-option" Classes.current="{Binding !EnglishSelected}" />
            <TextBlock Text="⇄" Opacity="0.65" />
            <TextBlock Text="{Binding Text[EnglishLanguage]}" Classes="switch-option" Classes.current="{Binding EnglishSelected}" />
          </StackPanel>
        </ToggleButton>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Classes="panel">
      <Grid ColumnDefinitions="Auto,*,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="10">
        <Button Content="{Binding Text[Open]}" Command="{Binding OpenCommand}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="5" IsEnabled="{Binding IsIdle}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Text[Tolerance]}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding Tolerance, StringFormat={}{0:0}}" Foreground="#7DD3FC" />
          </Grid>
          <Slider Minimum="0" Maximum="150" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Tolerance, Mode=TwoWay}" />
          <TextBlock Text="{Binding Text[ToleranceHelp]}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="5" IsEnabled="{Binding IsIdle}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Text[MinimumAlpha]}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding MinimumAlpha, StringFormat={}{0:0}/255}" Foreground="#7DD3FC" />
          </Grid>
          <Slider Minimum="1" Maximum="254" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MinimumAlpha, Mode=TwoWay}" />
          <TextBlock Text="{Binding Text[AlphaHelp]}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="3" Content="{Binding Text[Analyze]}" Command="{Binding AnalyzeCommand}" VerticalAlignment="Center" />
        <Grid Grid.Row="1" Grid.ColumnSpan="4" ColumnDefinitions="*,*" ColumnSpacing="16" IsEnabled="{Binding IsIdle}">
          <Border Background="#131C29" BorderBrush="#344255" BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <TextBlock Text="{Binding Text[ExportAreasAs]}" VerticalAlignment="Center" />
              <ComboBox x:Name="ExportAreaSelector" Grid.Column="1" SelectedIndex="{Binding ExportAreaIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="155">
                <ComboBoxItem Content="{Binding Text[AreaBlack]}" />
                <ComboBoxItem Content="{Binding Text[AreaWhite]}" />
                <ComboBoxItem Content="{Binding Text[AreaTransparent]}" />
                <ComboBoxItem Content="{Binding Text[AreaGroupColor]}" />
              </ComboBox>
              <Button Grid.Column="2" Content="{Binding Text[Contours]}" FontSize="11" Padding="8,8">
                <Button.Flyout>
                  <Flyout>
                    <StackPanel Width="340" Spacing="10">
                      <CheckBox x:Name="SmoothContoursToggle" Content="{Binding Text[SmoothContours]}" IsChecked="{Binding SmoothContours, Mode=TwoWay}" />
                      <Button Content="{Binding Text[TripleContourResolution]}" Command="{Binding TripleContourResolutionCommand}" />
                      <TextBlock Text="{Binding Text[TripleContourResolutionHelp]}" TextWrapping="Wrap" FontSize="12" Foreground="#7DD3FC" />
                      <TextBlock Text="{Binding Text[SmoothContoursHelp]}" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Grid>
          </Border>
          <Border Grid.Column="1" Background="#131C29" BorderBrush="#344255" BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
              <TextBlock Text="{Binding Text[ExportBackground]}" VerticalAlignment="Center" />
              <ComboBox x:Name="ExportBackgroundSelector" Grid.Column="1" SelectedIndex="{Binding ExportBackgroundIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="155">
                <ComboBoxItem Content="{Binding Text[BackgroundBlack]}" />
                <ComboBoxItem Content="{Binding Text[BackgroundGray]}" />
                <ComboBoxItem Content="{Binding Text[BackgroundWhite]}" />
                <ComboBoxItem Content="{Binding Text[BackgroundTransparent]}" />
              </ComboBox>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
      <controls:CollapsibleSidebar x:Name="ImagesSidebar" ExpandedWidth="220"
          IsCollapsed="{Binding ImagesSidebarCollapsed, Mode=TwoWay}" ReduceMotion="{Binding ReduceMotion}"
          RailLabel="{Binding ImagesRailLabel}" CollapseLabel="{Binding Text[CollapseImages]}" HasNotice="{Binding ImagesHasNotice}">
      <Border Classes="panel" Padding="12,20">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
          <Grid ColumnDefinitions="*,Auto" Margin="4,0">
            <TextBlock Text="{Binding Text[ImageList]}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding Images.Count}" Foreground="#7DD3FC" />
          </Grid>
          <TextBlock Grid.Row="1" Text="{Binding Text[ImageListHint]}" TextWrapping="Wrap" Classes="muted" FontSize="11" Margin="4,0" />
          <ListBox Grid.Row="2" ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                   IsEnabled="{Binding IsIdle}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="6" Margin="0,4" ToolTip.Tip="{Binding FilePath}">
                  <Border Background="#10151F" CornerRadius="6" ClipToBounds="True">
                    <Image Source="{Binding Thumbnail}" Height="85" Stretch="Uniform" Margin="4" />
                  </Border>
                  <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="12" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button x:Name="ImageSizeButton" Grid.Row="3" Content="{Binding Text[ImageSize]}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding HasImage}" IsEnabled="{Binding IsIdle}" ToolTip.Tip="{Binding ImageSizeSummary}">
            <Button.Flyout>
              <Flyout Placement="Right">
                <StackPanel Width="320" Spacing="8" IsEnabled="{Binding IsIdle}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Text[ImageSize]}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" />
                    <Button Grid.Column="1" Content="100 %" Command="{Binding ResetScaleCommand}" FontSize="10" Padding="5,3" ToolTip.Tip="{Binding Text[ResetScale]}" />
                  </Grid>
                  <Grid ColumnDefinitions="65,*,Auto" ColumnSpacing="5">
                    <ComboBox x:Name="ScaleUnitSelector" SelectedIndex="{Binding ScaleUnitIndex, Mode=TwoWay}" MinWidth="0" HorizontalAlignment="Stretch" Padding="6,4">
                      <ComboBoxItem Content="%" /><ComboBoxItem Content="cm" />
                    </ComboBox>
                    <NumericUpDown x:Name="ScaleDpiInput" Grid.Column="1" Value="{Binding ScaleDpi, Mode=TwoWay}" Minimum="1" Maximum="2400" Increment="1" FormatString="0" ShowButtonSpinner="False" MinWidth="0" Padding="5,4" FontSize="12" />
                    <TextBlock Grid.Column="2" Text="DPI" FontSize="10" VerticalAlignment="Center" Classes="muted" />
                  </Grid>
                  <NumericUpDown x:Name="ScalePercentInput" Value="{Binding ScalePercent, Mode=TwoWay}" IsVisible="{Binding IsScalePercent}" Minimum="0.0001" Maximum="1600000000" Increment="1" FormatString="0.####" ShowButtonSpinner="False" MinWidth="0" Padding="5,4" FontSize="12" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="6" IsVisible="{Binding IsScaleCm}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Text[WidthCm]}" FontSize="10" Classes="muted" />
                      <NumericUpDown x:Name="ScaleWidthInput" Value="{Binding ScaleWidthCm, Mode=TwoWay}" Minimum="0.0001" Maximum="100000" Increment="0.1" FormatString="0.###" ShowButtonSpinner="False" MinWidth="0" Padding="5,4" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{Binding Text[HeightCm]}" FontSize="10" Classes="muted" />
                      <NumericUpDown x:Name="ScaleHeightInput" Value="{Binding ScaleHeightCm, Mode=TwoWay}" Minimum="0.0001" Maximum="100000" Increment="0.1" FormatString="0.###" ShowButtonSpinner="False" MinWidth="0" Padding="5,4" FontSize="12" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding Text[AspectLocked]}" FontSize="10" Foreground="#7DD3FC" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ImageSizeSummary}" FontSize="10" Classes="muted" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Text[ScaleHelp]}" FontSize="11" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6">
            <Button Content="{Binding Text[RemoveImage]}" Command="{Binding RemoveImageCommand}" FontSize="11" Padding="8,8" />
            <Button Content="{Binding Text[ClearImages]}" Command="{Binding ClearImagesCommand}" FontSize="11" Padding="8,8" />
          </StackPanel>
        </Grid>
      </Border>
      </controls:CollapsibleSidebar>
      <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <WrapPanel>
            <ToggleButton x:Name="PreviewLayoutSelector" Classes="toolbar" IsChecked="{Binding SideBySide, Mode=TwoWay}" IsVisible="{Binding !IsLaserMode}" Margin="0,0,8,4" ToolTip.Tip="{Binding Text[PreviewLayout]}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="{Binding Text[LayoutStacked]}" Classes="switch-option" Classes.current="{Binding !SideBySide}" />
                <TextBlock Text="⇄" Opacity="0.65" />
                <TextBlock Text="{Binding Text[LayoutSideBySide]}" Classes="switch-option" Classes.current="{Binding SideBySide}" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="SyncPreviewsToggle" Classes="toolbar" Content="{Binding Text[SyncPreviews]}" IsChecked="{Binding SynchronizePreviews, Mode=TwoWay}" IsVisible="{Binding !IsLaserMode}" ToolTip.Tip="{Binding Text[SyncPreviewsHelp]}" Margin="0,0,8,4" />
            <ToggleButton x:Name="SidebarsToggle" Classes="toolbar" Content="{Binding PreviewOnlyLabel}" Command="{Binding PreviewOnlyCommand}" IsChecked="{Binding IsPreviewOnly, Mode=OneWay}" ToolTip.Tip="{Binding Text[ToggleSidebarsHelp]}" Margin="0,0,0,4" />
          </WrapPanel>
          <ToggleButton x:Name="CombinedPreviewToggle" Grid.Column="1" Classes="toolbar" Content="{Binding Text[CombinedPreview]}" IsChecked="{Binding ShowCombinedPreview, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" IsVisible="{Binding !IsLaserMode}" ToolTip.Tip="{Binding Text[CombinedHelp]}" VerticalAlignment="Top" Margin="0,0,0,4" />
        </Grid>
      <Grid x:Name="PreviewPanels" Grid.Row="1" RowDefinitions="*,8,*" IsVisible="{Binding !IsLaserMode}">
        <Border x:Name="OriginalPreviewPanel" Classes="panel">
          <Grid RowDefinitions="Auto,*" RowSpacing="12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <TextBlock Text="{Binding Text[Original]}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding FileName}" Classes="muted" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
            </Grid>
            <Border Grid.Row="1" Background="#10151F" CornerRadius="8" ClipToBounds="True">
              <Grid>
                <TextBlock Text="{Binding Text[Hint]}" IsVisible="{Binding !HasImage}" TextWrapping="Wrap" MaxWidth="320" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Classes="muted" Margin="20" />
                <controls:ImageViewport x:Name="OriginalViewportControl" Source="{Binding Original}" Margin="8"
                    Zoom="{Binding OriginalViewport.Zoom, Mode=TwoWay}" CenterX="{Binding OriginalViewport.CenterX, Mode=TwoWay}" CenterY="{Binding OriginalViewport.CenterY, Mode=TwoWay}" />
                <Border Background="#E610151F" CornerRadius="5" Margin="6" Padding="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsVisible="{Binding HasImage}">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <Button Content="−" Command="{Binding OriginalViewport.ZoomOutCommand}" Padding="6,2" ToolTip.Tip="{Binding Text[PreviewZoomOut]}" />
                    <TextBlock Text="{Binding OriginalViewport.ZoomLabel}" Width="40" FontSize="11" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Content="+" Command="{Binding OriginalViewport.ZoomInCommand}" Padding="6,2" ToolTip.Tip="{Binding Text[PreviewZoomIn]}" />
                    <Button Content="{Binding Text[FitPreview]}" Command="{Binding OriginalViewport.FitCommand}" FontSize="11" Padding="6,2" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </Border>
        <GridSplitter x:Name="PreviewDivider" Grid.Row="1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#345065" ToolTip.Tip="{Binding Text[ResizePreviews]}" />
        <Border x:Name="ExportPreviewPanel" Grid.Row="2" Classes="panel">
          <Grid RowDefinitions="Auto,*" RowSpacing="12">
            <TextBlock Text="{Binding Text[Mask]}" FontWeight="SemiBold" />
            <Border Grid.Row="1" Background="{StaticResource TransparencyBackground}" CornerRadius="8" ClipToBounds="True">
              <Grid>
                <TextBlock Text="{Binding Text[MaskHint]}" IsVisible="{Binding !HasMask}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" Margin="20" />
                <controls:ImageViewport x:Name="ExportViewportControl" Source="{Binding Mask}" Margin="8"
                    Zoom="{Binding ExportViewport.Zoom, Mode=TwoWay}" CenterX="{Binding ExportViewport.CenterX, Mode=TwoWay}" CenterY="{Binding ExportViewport.CenterY, Mode=TwoWay}" />
                <Border Background="#E610151F" CornerRadius="5" Margin="6" Padding="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsVisible="{Binding HasMask}">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <Button Content="−" Command="{Binding ExportViewport.ZoomOutCommand}" Padding="6,2" ToolTip.Tip="{Binding Text[PreviewZoomOut]}" />
                    <TextBlock Text="{Binding ExportViewport.ZoomLabel}" Width="40" FontSize="11" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Content="+" Command="{Binding ExportViewport.ZoomInCommand}" Padding="6,2" ToolTip.Tip="{Binding Text[PreviewZoomIn]}" />
                    <Button Content="{Binding Text[FitPreview]}" Command="{Binding ExportViewport.FitCommand}" FontSize="11" Padding="6,2" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="1" Classes="panel" IsVisible="{Binding IsLaserMode}">
        <views:LaserWorkspaceView DataContext="{Binding Laser}" />
      </Border>
      </Grid>
      <controls:CollapsibleSidebar x:Name="RightSidebar" Grid.Column="2" ExpandedWidth="270" IsRight="True"
          IsCollapsed="{Binding RightSidebarCollapsed, Mode=TwoWay}" ReduceMotion="{Binding ReduceMotion}"
          RailLabel="{Binding RightRailLabel}" CollapseLabel="{Binding Text[CollapseRight]}" HasNotice="{Binding RightHasNotice}">
      <Grid>
      <Border Classes="panel" Padding="14,20" IsVisible="{Binding IsLaserMode}">
        <views:LaserPagesView DataContext="{Binding Laser}" />
      </Border>
      <Border Classes="panel" Padding="14,20" IsVisible="{Binding !IsLaserMode}">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
          <StackPanel Spacing="8" Margin="6,0">
            <TextBlock Text="{Binding Text[Colors]}" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="{Binding Text[ExportColors]}" FontSize="11" Classes="muted" />
                <TextBlock Text="{Binding ExportColorCount}" FontSize="11" Foreground="#7DD3FC" />
              </StackPanel>
              <Button Grid.Column="1" Content="{Binding Text[AllColors]}" Command="{Binding SelectAllColorsCommand}" FontSize="11" Padding="7,4" />
              <Button Grid.Column="2" Content="{Binding Text[NoColorSelection]}" Command="{Binding DeselectAllColorsCommand}" FontSize="11" Padding="7,4" />
            </Grid>
          </StackPanel>
          <Grid Grid.Row="1">
            <TextBlock Text="{Binding Text[EmptyColors]}" IsVisible="{Binding !HasGroups}" Classes="muted" TextWrapping="Wrap" Margin="6,8" />
            <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" Background="Transparent" IsEnabled="{Binding IsIdle}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" Margin="0,5">
                    <CheckBox IsChecked="{Binding ExportEnabled, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" Padding="0" />
                    <controls:ColorSwatch Grid.Column="1" />
                    <StackPanel Grid.Column="2" Spacing="2">
                      <TextBlock Text="{Binding Hex}" FontWeight="SemiBold" FontSize="13" />
                      <TextBlock Text="{Binding PixelCount}" Classes="muted" FontSize="11" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding Coverage}" VerticalAlignment="Center" Classes="muted" FontSize="11" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <Expander Grid.Row="2" Header="{Binding Text[ExportHelp]}" Margin="6,0" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding ExportOutputHelp}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Text[BatchHelp]}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Text[SelectionHint]}" ToolTip.Tip="{Binding Text[ColorSelectionHelp]}" Foreground="#7DD3FC" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Expander>
        </Grid>
      </Border>
    </Grid>
    </controls:CollapsibleSidebar>
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="10">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Classes="muted" MaxHeight="64" />
      <Button Grid.Column="1" Content="{Binding Text[OpenLastExport]}" Command="{Binding OpenLastExportFolderCommand}" IsEnabled="{Binding CanOpenLastExportFolder}" ToolTip.Tip="{Binding LastExportFolder}" />
      <Button Grid.Column="2" Content="{Binding Text[Cancel]}" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
      <Button Grid.Column="3" Content="{Binding Text[Export]}" Command="{Binding ExportCommand}" IsVisible="{Binding !IsLaserMode}" />
      <Button Grid.Column="4" Content="{Binding Text[ExportBatch]}" Command="{Binding ExportBatchCommand}" IsVisible="{Binding !IsLaserMode}" Background="#89D6FA" Foreground="#0B2333" FontWeight="SemiBold" />
      <Button Grid.Column="5" Content="{Binding Text[ExportCombined]}" Command="{Binding ExportCombinedBatchCommand}" IsVisible="{Binding !IsLaserMode}" ToolTip.Tip="{Binding Text[CombinedHelp]}" />
      <Button Grid.Column="3" Content="{Binding Text[LaserExportPage]}" Command="{Binding Laser.ExportPageCommand}" IsVisible="{Binding IsLaserMode}" />
      <Button Grid.Column="4" Content="{Binding Text[LaserExportAll]}" Command="{Binding Laser.ExportAllCommand}" IsVisible="{Binding IsLaserMode}" Background="#89D6FA" Foreground="#0B2333" FontWeight="SemiBold" />
      <Button Grid.Column="5" Content="{Binding Text[ExportCombined]}" Command="{Binding Laser.ExportMergedCommand}" IsVisible="{Binding IsLaserMode}" ToolTip.Tip="{Binding Text[LaserMergedHelp]}" />
      <ProgressBar Grid.Row="1" Grid.ColumnSpan="6" IsVisible="{Binding IsBusy}" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Height="4" />
    </Grid>
    <Expander Grid.Row="4" Header="{Binding Text[ErrorDetails]}" IsVisible="{Binding HasErrors}" HorizontalAlignment="Stretch">
      <TextBox Text="{Binding ErrorDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" />
    </Expander>
  </Grid>
  </Grid>
</Window>
