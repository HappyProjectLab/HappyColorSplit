<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HappyColorSplit.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <DrawingBrush x:Key="TransparencyBackground" TileMode="Tile" DestinationRect="0,0,16,16">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#485364">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16" /></GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#303947">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,8,8" /></GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#303947">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="8,8,8,8" /></GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" /></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="16,10" /></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="#1C2432" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="20" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#A9B6CC" /></Style>
  </Application.Styles>
</Application>
